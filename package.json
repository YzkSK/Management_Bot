    "test:integration:local": "bun run scripts/test-integration-local.ts",
    "dev": "turbo run dev"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "turbo": "^2.0.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "esbuild": "^0.25.12"
  }
}
