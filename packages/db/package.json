{
  "name": "@management-bot/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/migrate.ts",
    "db:migrate:drizzle": "drizzle-kit migrate"
  },
  "dependencies": {
    "@management-bot/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.3",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}
