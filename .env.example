# docker-compose.ymlのPostgresパスワード(必須)。URLに埋め込むためURLセーフな値にする(例: openssl rand -hex 32)。
# 既存ボリュームはPOSTGRES_PASSWORDの変更が反映されないため、切り替え前に旧パスワードのまま以下で変更しておく:
#   docker compose exec postgres psql -U management_bot -c "ALTER USER management_bot PASSWORD '<新しい値>'"
POSTGRES_PASSWORD=
# docker-compose.ymlのRedisパスワード(必須)。REDIS_URLに埋め込むためURLセーフな値にする(例: openssl rand -hex 32)。
REDIS_PASSWORD=
DATABASE_URL=postgres://user:password@localhost:5432/management_bot
REDIS_URL=redis://localhost:6379
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=http://localhost:8787/auth/callback
# ダッシュボードの鍵の元(32文字以上、例: openssl rand -hex 32)。HKDFでトークン暗号化用・OAuth state署名用の鍵を導出する。
# ローテーション手順: 値を差し替え、sessionsテーブルを空にしてからdashboard-apiを再起動する(全員が再ログインになる)。
# 空にしないと、既存セッションは有効なまま保存トークンだけ復号できない中途半端な状態になる。
#   docker compose exec postgres psql -U management_bot -c "DELETE FROM sessions"
SESSION_SECRET=
DASHBOARD_WEB_URL=http://localhost:5173
BACKUP_CRON=0 3 * * *
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=7
LOGGING_RETENTION_CRON=0 4 * * *
MODERATION_DECAY_CRON=0 * * * *
ACTIVITY_ROLLUP_CRON=15 4 * * *
TEMP_VOICE_GRACE_CRON=* * * * *
SESSION_CLEANUP_CRON=30 4 * * *
